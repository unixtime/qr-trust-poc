# QR Trust reference-network production-candidate adoption inputs.
#
# This template is intentionally fail-closed. Replace every empty value and
# flip every false boolean only after the corresponding operator-owned control
# exists. Do not put real secrets in this public example.

QRTRUST_ADOPTION_STAGE=3
QRTRUST_ADOPTION_CLAIM_MODE=production_candidate
QRTRUST_ADOPTION_REFERENCE_PRESET=false

# Optional evidence map. Production-candidate status requires configured
# controls and evidence references for every passing boundary.
QRTRUST_ADOPTION_EVIDENCE_JSON=
QRTRUST_ADOPTION_OPERATOR_EVIDENCE_INDEX_JSON=

# Durable trust-state authority.
QRTRUST_ADOPTION_POSTGRES_READY=false

# Governance and delegated-authority publication.
QRTRUST_ADOPTION_AUTHORITY_PUBLICATION_READY=false

# Propagation only. NATS must never become the source of trust.
QRTRUST_ADOPTION_NATS_READY=false

# Verifier read model and scanner-visible decision runtime.
QRTRUST_ADOPTION_VERIFIER_CACHE_READY=false
QRTRUST_ADOPTION_SCANNER_DECISION_READY=false

# Evidence packets proving the decision model across scanners and surfaces.
QRTRUST_ADOPTION_SCANNER_FLEET_EVIDENCE_READY=false
QRTRUST_ADOPTION_CROSS_SURFACE_EVIDENCE_READY=false
QRTRUST_ADOPTION_WORKER_OPERATIONS_EVIDENCE_READY=false

# Custody evidence and managed signing custody.
QRTRUST_ADOPTION_SIGNING_CUSTODY_AUDIT_EXPORT_READY=false
QRTRUST_ADOPTION_SIGNING_CUSTODY_READY=false

# Live scan-time safety and operator-owned recovery posture.
QRTRUST_ADOPTION_RUNTIME_SAFETY_READY=false
QRTRUST_ADOPTION_OPERATOR_RUNBOOKS_READY=false
QRTRUST_ADOPTION_BACKUP_RESTORE_READY=false
QRTRUST_ADOPTION_EXTERNAL_GOVERNANCE_AUDIT_READY=false

# Local output. Keep generated reports out of committed contract examples.
QRTRUST_ADOPTION_JSON=../local/reference-network-adoption-production-report.json
QRTRUST_ADOPTION_MD=../local/reference-network-adoption-production-report.md
