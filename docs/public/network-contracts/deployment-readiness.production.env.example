# QR Trust production readiness report inputs.
#
# This template is intentionally fail-closed. Replace every empty value and
# flip every false boolean only after the corresponding operator-owned control
# exists. Do not put real secrets in this public example.

QRTRUST_DEPLOYMENT_READINESS_MODE=production

# Optional evidence map. Production-ready status requires configured controls
# and evidence references for every passing check.
QRTRUST_DEPLOYMENT_READINESS_EVIDENCE_JSON=

# Dedicated QR Trust source-of-truth database. Do not reuse another product's
# operational database.
QRTRUST_NETWORK_DATABASE_URL=

# Schema and restore controls.
QRTRUST_MIGRATION_LEDGER_ENABLED=false
QRTRUST_RESTORE_AUTOMATION_DOCUMENTED=false
QRTRUST_PACKAGED_DEPLOYMENT_OWNERSHIP_DOCUMENTED=false

# Propagation. NATS is notification/propagation only; Postgres remains source
# of truth.
QRTRUST_NETWORK_NATS_URL=

# Managed verification and signing custody references.
QRTRUST_MANAGED_KEY_MATERIAL_PROVIDER=
QRTRUST_MANAGED_SIGNING_CUSTODY_PROVIDER=
QRTRUST_CUSTODY_AUDIT_EXPORT_CONFIGURED=false

# Scan-time runtime evidence provider.
QRTRUST_RUNTIME_SAFETY_PROVIDER=

# Scanner-visible audit and operations readiness.
QRTRUST_SCANNER_DECISION_PERSISTENCE_ENABLED=false
QRTRUST_WORKER_OPERATIONS_EVIDENCE_READY=false
QRTRUST_OPERATOR_RUNBOOKS_DOCUMENTED=false
