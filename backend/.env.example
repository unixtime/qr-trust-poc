# Application Configuration
DEBUG=False

# Database Configuration
DB_HOST=localhost
DB_USER=qr_admin
DB_PASSWORD=your_secure_password_here
DB_NAME=qr_db
DB_PORT=5432

# Security
SECRET_KEY=generate_your_own_secret_key_here_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS (optional - leave empty when using the built-in same-origin lab)
# CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# CORS_ALLOW_CREDENTIALS=false

# Verifier rate limiting
# VERIFIER_RATE_LIMIT_WINDOW_SECONDS=60
# VERIFIER_RATE_LIMIT_MAX_REQUESTS=60
# VERIFIER_DECODE_RATE_LIMIT_MAX_REQUESTS=120

# Optional verifier API key auth for POST endpoints
# VERIFIER_API_KEYS=["replace-with-long-random-key"]
# VERIFIER_STATIC_API_KEYS_ENABLED=false
# VERIFIER_API_KEY_HEADER=X-API-Key
# VERIFIER_ADMIN_TOKENS=["replace-with-long-random-admin-token"]
# VERIFIER_BOOTSTRAP_ADMIN_TOKENS_ENABLED=false
# VERIFIER_ADMIN_HEADER=X-Admin-Token

# RSA Keys (Optional - will be generated if not provided)
# PRIVATE_KEY=
# PUBLIC_KEY=

# Redis Configuration
REDIS_HOSTNAME=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
# REDIS_STARTUP_ENABLED=true

# Optional QR Trust network source-of-truth database.
# When configured, GET /verifier/status includes operator evidence for the
# network outbox and runtime-safety observations. Leave unset for the standalone
# verifier lab.
# QRTRUST_NETWORK_DATABASE_URL=postgres://publisher:publisher@127.0.0.1:5432/qr_trust_poc

# Blockchain (Optional)
BLOCKCHAIN_NODE_URL=http://localhost:8545

# External API Keys
USPTO_API_KEY=your_uspto_api_key_here

# Domain Verification Settings
DOMAIN_VERIFICATION_TEST_MODE=true  # Set to false in production
TEST_VERIFIED_DOMAINS=["acme-corp.test","secure-bank.test","local-business.test","example.com","localhost"]
DOMAIN_VERIFICATION_TIMEOUT=10  # Seconds for DNS/HTTP requests
VERIFICATION_TOKEN_TTL=3600  # 1 hour for verification tokens
DNS_SERVER=127.0.0.1  # Set to 127.0.0.1 to use Docker test DNS (or leave empty for system DNS)
DNS_PORT=5354  # DNS port (5354 for Docker test environment, 53 for production)

# Application Settings
# Add any additional configuration here
